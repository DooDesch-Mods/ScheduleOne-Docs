---
/**
 * Two images of the same view on top of each other, with a handle that wipes between them.
 * The range input carries the state, so mouse, touch and keyboard all move it, and screen readers announce it.
 * Without JavaScript the split stays at the middle.
 */
interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  /** Optional name of the view, shown bottom left (for example "Outside" when a card has two views). */
  caption?: string;
  width?: number;
  height?: number;
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  caption = '',
  width = 1600,
  height = 900,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (path: string) => (path.startsWith('/') ? base + path : path);
---

<figure class="before-after not-content" style={`--pos: 50%; aspect-ratio: ${width} / ${height};`}>
  <img class="ba-img" src={src(after)} alt={afterAlt} width={width} height={height} loading="lazy" decoding="async" />
  <img class="ba-img ba-before" src={src(before)} alt={beforeAlt} width={width} height={height} loading="lazy" decoding="async" />
  <span class="ba-tag ba-tag-before">{beforeLabel}</span>
  <span class="ba-tag ba-tag-after">{afterLabel}</span>
  {caption && <span class="ba-tag ba-tag-caption">{caption}</span>}
  <span class="ba-line" aria-hidden="true">
    <span class="ba-knob">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5"></path><path d="m15 7 5 5-5 5"></path></svg>
    </span>
  </span>
  <input class="ba-range" type="range" min="0" max="100" step="0.5" value="50" aria-label={`Wipe between ${beforeLabel.toLowerCase()} and ${afterLabel.toLowerCase()}`} />
</figure>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('.before-after')) {
    const range = figure.querySelector<HTMLInputElement>('.ba-range');
    if (!range) {
      console.error('before-after: figure without its range input, the wipe stays at the middle', figure);
      continue;
    }
    const apply = () => figure.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .before-after {
    position: relative;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    user-select: none;
    touch-action: pan-y;
  }
  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: #fff;
    background: rgb(0 0 0 / 0.6);
    pointer-events: none;
  }
  .ba-tag-before {
    left: 0.75rem;
  }
  .ba-tag-after {
    right: 0.75rem;
  }
  .ba-tag-caption {
    top: auto;
    bottom: 0.75rem;
    left: 0.75rem;
  }
  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.5rem;
    height: 2.5rem;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
  }
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .before-after:has(.ba-range:focus-visible) .ba-knob {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
