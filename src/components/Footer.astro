---
// Starlight's footer, plus the page-feedback control.
//
// The control itself is public/feedback.js - a standalone file with no dependencies, so the other
// doodesch.de sites can include the same URL rather than each growing their own copy. This component only
// decides WHERE it appears.
//
// Not on the splash page: "Was this page useful?" under a landing page asks about nothing. Not without
// Umami either, because the thumb would have nowhere to go.
import Default from '@astrojs/starlight/components/Footer.astro';

// `process.env`, never `import.meta.env`. Vite inlines the latter at build time, so a value supplied to the
// build is fine but a value supplied later never arrives - and with no value at build time the condition
// folds to false and this block vanishes from the output entirely, with no tag, no id and no error to see.
// astro.config.mjs reads the same variable the same way; the two must not disagree about where it comes from.
const isSplash = Astro.locals.starlightRoute?.entry?.data?.template === 'splash';
const show = !isSplash && Boolean(process.env.PUBLIC_UMAMI_ID);
---

<Default><slot /></Default>

{show && (
  <script is:inline defer src="/feedback.js" data-support="https://support.doodesch.de/docs"></script>
)}
